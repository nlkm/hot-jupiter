\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Discovery of Trajectory Bifurcation}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Scenario 1: Runaway Tidal Disruption ($0.6\,M_{\text  {Jup}}, 0.016\text  { AU}, e_0=0.15$).} Coupled time evolution of orbital semi-major axis $a(t)$, orbital eccentricity $e(t)$, planetary mass $M_p(t)$, and radius $R_p(t)$. Rapid planetary tidal dissipation circularizes the orbit ($e \to 0$ in $t \lesssim 100\text  { Myr}$) prior to runaway RLOF mass loss and tidal engulfment into the host star.}}{2}{}\protected@file@percent }
\newlabel{fig:scenario1}{{1}{2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Scenario 2: Self-Limiting RLOF Stagnation ($0.8\,M_{\text  {Jup}}, 0.019\text  { AU}, e_0=0.15$).} Coupled time evolution of semi-major axis $a(t)$, eccentricity $e(t)$, mass $M_p(t)$, and radius $R_p(t)$. Tidal circularization damps eccentricity to zero ($e \to 0$), while envelope stripping drives structural contraction ($R_p \propto M_p^{0.6}$), halting mass loss and allowing the planet to survive as a circularized USP remnant.}}{2}{}\protected@file@percent }
\newlabel{fig:scenario2}{{2}{2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Scenario 3: Non-Overflow Radiative Cooling ($1.0\,M_{\text  {Jup}}, 0.030\text  { AU}, e_0=0.15$).} Coupled evolution of semi-major axis $a(t)$, eccentricity $e(t)$, mass $M_p(t)$, and radius $R_p(t)$ for a planet that remains sub-overflow ($\mu _{\text  {Roche}} < 1$). Tidal circularization damps the eccentricity to $e \approx 0$ within $\sim 300\text  { Myr}$ while the planet undergoes standard thermal radius decay.}}{3}{}\protected@file@percent }
\newlabel{fig:scenario3}{{3}{3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Scenario 4: High-Eccentricity Warm Jupiter Evolution ($1.0\,M_{\text  {Jup}}, 0.050\text  { AU}, e_0=0.45$).} Coupled time evolution of semi-major axis $a(t)$, persistent tidal eccentricity damping $e(t)$, periastron separation $r_{\text  {peri}}(t) = a(t)(1-e(t))$, and radius contraction $R_p(t)$. For wider orbits ($a_0 = 0.050\text  { AU}$), tidal circularization timescales $\tau _e \propto a^{13/2}$ exceed $\sim 3\text  { Gyr}$, allowing non-zero eccentricity to persist into multi-Gyr system ages.}}{3}{}\protected@file@percent }
\newlabel{fig:scenario4}{{4}{3}{}{}{}}
