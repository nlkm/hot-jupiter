\newlabel{fig:tracks}{{1}{2}{\textbf {Orbital Decay and Mass Loss Evolution.} Time evolution of semi-major axis $a(t)$ (left) and planet mass $M_p(t)$ (right) across 3 representative tracks: (1) Runaway Disruption (red solid), (2) Stagnated Survival (blue dashed), and (3) Non-Overflow Cooling (green dash-dotted)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Roche Lobe Radius Contraction and Filling Factor.} Time evolution of planetary radius $R_p(t)$ vs. Roche lobe radius $R_{\text  {Roche}}(t)$ (left) and filling factor $\mu _{\text  {Roche}}(t) = R_p / R_{\text  {Roche}}$ (right). Overfilling ($\mu _{\text  {Roche}} \ge 1.0$) initiates hydrodynamic envelope stripping.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:filling}{{2}{2}{\textbf {Roche Lobe Radius Contraction and Filling Factor.} Time evolution of planetary radius $R_p(t)$ vs. Roche lobe radius $R_{\text {Roche}}(t)$ (left) and filling factor $\mu _{\text {Roche}}(t) = R_p / R_{\text {Roche}}$ (right). Overfilling ($\mu _{\text {Roche}} \ge 1.0$) initiates hydrodynamic envelope stripping}{figure.2}{}}
