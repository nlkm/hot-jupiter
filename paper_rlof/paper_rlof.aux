\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Roche Lobe Radius Contraction and Filling Factor.} Time evolution of filling factor $\mu _{\text  {Roche}}(t) = R_p / R_{\text  {Roche}}$. Overfilling ($\mu _{\text  {Roche}} \ge 1.0$, red shaded region) initiates hydrodynamic mass loss, while sub-overflow ($\mu _{\text  {Roche}} < 1.0$, green shaded region) represents stable cooling.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:filling}{{2}{2}{\textbf {Roche Lobe Radius Contraction and Filling Factor.} Time evolution of filling factor $\mu _{\text {Roche}}(t) = R_p / R_{\text {Roche}}$. Overfilling ($\mu _{\text {Roche}} \ge 1.0$, red shaded region) initiates hydrodynamic mass loss, while sub-overflow ($\mu _{\text {Roche}} < 1.0$, green shaded region) represents stable cooling}{figure.2}{}}
