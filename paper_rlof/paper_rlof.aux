\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Survival Phase Space Diagram \& Trajectory Flow.} 2D phase diagram mapping final planet mass $M_p(t_{\mathrm  {final}})$ in initial semi-major axis $a(0)$ vs. initial planet mass $M_p(0)$ space. Solid curves with arrows show evolutionary trajectories $[a(t), M_p(t)]$ for representative initial conditions. The red dashed line denotes the analytical Roche limit $M_{\text  {crit}}(a) \propto a^{3.0}$.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:phase_map}{{2}{4}{\textbf {Survival Phase Space Diagram \& Trajectory Flow.} 2D phase diagram mapping final planet mass $M_p(t_{\mathrm {final}})$ in initial semi-major axis $a(0)$ vs. initial planet mass $M_p(0)$ space. Solid curves with arrows show evolutionary trajectories $[a(t), M_p(t)]$ for representative initial conditions. The red dashed line denotes the analytical Roche limit $M_{\text {crit}}(a) \propto a^{3.0}$}{figure.2}{}}
