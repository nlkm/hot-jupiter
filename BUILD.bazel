package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hot_jupiter_lib",
    srcs = [
        "cpp/src/interior.cpp",
        "cpp/src/c_api.cpp",
    ],
    hdrs = [
        "cpp/include/atmosphere.hpp",
        "cpp/include/c_api.h",
        "cpp/include/constants.hpp",
        "cpp/include/eos.hpp",
        "cpp/include/heating.hpp",
        "cpp/include/interior.hpp",
        "cpp/include/mass_loss.hpp",
        "cpp/include/multi_planet.hpp",
        "cpp/include/orbital.hpp",
        "cpp/include/population_synth.hpp",
        "cpp/include/rlof_engine.hpp",
    ],
    includes = ["cpp/include"],
    copts = ["-std=c++17", "-O3", "-fopenmp", "-fvisibility=default"],
    linkopts = ["-fopenmp"],
    alwayslink = True,
)

cc_binary(
    name = "libhot_jupiter_cpp.so",
    linkshared = True,
    deps = [":hot_jupiter_lib"],
)

